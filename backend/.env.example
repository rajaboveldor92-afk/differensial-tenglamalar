# Copy to .env (never commit .env) or set these in your host's secret settings.
ANTHROPIC_API_KEY=
# Check current model ids and prices at https://platform.claude.com/docs before deploying.
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
PORT=8787
# Optional obstacle against casual misuse (it is visible inside the APK, so it is NOT a secret):
APP_TOKEN=
RATE_PER_MIN=6
RATE_PER_DAY=120
DAILY_REQUEST_CAP=2000
# Set to 1 only when the server is behind a trusted reverse proxy that overwrites X-Forwarded-For.
# Otherwise a client can spoof that header and evade per-IP limits.
TRUST_PROXY=0
# Set to "off" to disable the server-side refusal fallback (beta)
AI_FALLBACKS=
